#!/usr/bin/env python3
# Scans currently established outbound TCP connections (via `ss`), geolocates
# each remote IP's country (cached on disk, MaxMind-free HTTPS lookup for
# whatever isn't cached yet), and prints a JSON summary of the connections
# whose country is outside the caller-supplied allow-list.
#
# argv[1]: comma-separated ISO 3166-1 alpha-2 country codes to treat as "home"
#          (not flagged). Defaults to "US" if omitted/empty.
#
# Threat model this file defends against: `ss`'s stdout, the on-disk cache,
# and the GeoIP HTTPS response are each read into memory with a streaming
# byte ceiling and an absolute wall-clock deadline (not just a per-syscall
# timeout), so a pathological/hostile producer can't grow memory unbounded
# or hang a scan. The GeoIP fetch resolves and connects to a pinned IP (SNI
# and cert hostname checks still run against the real hostname) so a second,
# different DNS answer at connect time can't steer the request somewhere the
# redirect check never saw. The disk cache is reached via a component-wise
# walk of open, fstat-verified directory descriptors (owner is us or root,
# never group/other-writable, never a symlink) and written through that
# held directory fd as a randomly named 0600 temp file, fsynced, then
# renamed into place — so there's no path-based TOCTOU window. Every field
# that survives all of that is still bounded/typed before being handed to
# the QML side as JSON, since it records which remote hosts this machine
# has been talking to.

import ipaddress
import json
import math
import os
import re
import secrets
import selectors
import signal
import socket
import ssl
import stat
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from http.client import HTTPSConnection
from urllib.parse import urljoin, urlsplit


class ScanUnavailable(Exception):
    """Raised whenever `ss` didn't complete cleanly with a verified zero
    exit and fully drained output. This is a security-monitoring widget, so
    a scan that couldn't actually run must never be presented as a clean
    "nothing flagged" result — main() turns this into a failed process
    exit instead, which the panel already surfaces as a scan error."""

CACHE_TTL = 7 * 24 * 3600
LOOKUP_TIMEOUT = 2.5
MAX_NEW_LOOKUPS = 8
MAX_WORKERS = 5
# Safety bound on the JSON payload, not a "top N" display cap — the panel
# scrolls through everything returned here. A real host won't have anywhere
# near this many distinct flagged (ip, port) pairs established at once; this
# just keeps a pathological case from producing an unbounded response.
MAX_FLAGGED_ENTRIES = 500

# Byte ceilings for the untrusted-size inputs this script reads: a
# geoip-lookup HTTPS response, `ss`'s stdout, the on-disk cache file, and
# the assembled result payload. All are normally tiny; these stop a
# pathological/hostile producer from being read into memory unbounded.
MAX_RESPONSE_BYTES = 64 * 1024
MAX_SS_OUTPUT_BYTES = 1024 * 1024
MAX_CACHE_BYTES = 2 * 1024 * 1024
MAX_RESULT_BYTES = 256 * 1024
MAX_REDIRECTS = 5

SS_TIMEOUT = 5.0
SS_POLL_INTERVAL = 0.2

MAX_COUNTRY_NAME_LEN = 100
MAX_ALLOWED_CODES = 50
MAX_CACHE_ENTRIES = 2000
COUNTRY_CODE_RE = re.compile(r"^[A-Z]{2}$")

# Directory/file components in the cache path are only trusted if owned by
# us or by root (e.g. the ancestor system directories above $HOME).
_TRUSTED_OWNERS = {0, os.getuid()}


# --------------------------------------------------------------- sanitizers

def _sanitize_country_code(code):
    code = (code or "").strip().upper()
    return code if COUNTRY_CODE_RE.match(code) else ""


def _sanitize_country_name(name):
    if not isinstance(name, str):
        return ""
    return name[:MAX_COUNTRY_NAME_LEN]


def _is_public_address(addr):
    return not (addr.is_private or addr.is_loopback or addr.is_link_local
                or addr.is_multicast or addr.is_reserved or addr.is_unspecified)


def _sanitize_cache(cache):
    """load_cache_fd only guarantees the top-level JSON was an object —
    each value is still on-disk data that could be corrupted or (via the
    dir-fd/ownership checks failing open somewhere) attacker-controlled.
    Keep only entries whose key is a real IP literal and whose value is a
    correctly shaped {code, name, ts} record; drop anything else rather
    than let a single malformed record (e.g. a null value) crash every
    subsequent scan via an unchecked .get()."""
    out = {}
    for key, value in cache.items():
        try:
            ipaddress.ip_address(key)
        except (ValueError, TypeError):
            continue
        if not isinstance(value, dict):
            continue
        code = _sanitize_country_code(value.get("code"))
        if not code:
            continue
        ts = value.get("ts")
        if not isinstance(ts, (int, float)) or isinstance(ts, bool) or not math.isfinite(ts) or ts < 0:
            continue
        out[key] = {"code": code, "name": _sanitize_country_name(value.get("name")), "ts": float(ts)}
    return out


# ------------------------------------------------------------- pinned fetch

def _resolve_public_ip(hostname, timeout):
    """Resolves `hostname` to a public IP, bounded by `timeout` seconds.
    socket.getaddrinfo() has no native timeout — it's a blocking libc call,
    not a socket operation — so this runs it on a daemon thread and stops
    waiting after `timeout`. A stuck resolver thread is left to die on its
    own (daemon=True means it can't block process exit either); the point
    is that the caller's logical wait, and therefore the whole scan, stays
    bounded even when the underlying OS call doesn't return in time."""
    box = {}

    def _resolve():
        try:
            box["infos"] = socket.getaddrinfo(hostname, None, proto=socket.IPPROTO_TCP)
        except OSError:
            box["infos"] = []

    t = threading.Thread(target=_resolve, daemon=True)
    t.start()
    t.join(max(timeout, 0))
    if t.is_alive():
        return None
    for info in box.get("infos", []):
        candidate = info[4][0].split("%")[0]
        try:
            addr = ipaddress.ip_address(candidate)
        except ValueError:
            continue
        if _is_public_address(addr):
            return candidate
    return None


class _PinnedHTTPSConnection(HTTPSConnection):
    """An HTTPSConnection whose TCP connect() targets a caller-supplied
    literal IP instead of re-resolving self.host, so DNS can't answer
    differently between the redirect-target check and the actual connect.
    SNI and certificate hostname verification still use self.host, i.e. the
    real hostname, so this only pins the transport address."""

    def __init__(self, hostname, pinned_ip, port, timeout, context):
        HTTPSConnection.__init__(self, hostname, port, timeout=timeout, context=context)
        self._pinned_ip = pinned_ip

    def connect(self):
        sock = socket.create_connection((self._pinned_ip, self.port), self.timeout)
        self.sock = self._context.wrap_socket(sock, server_hostname=self.host)


def _fetch_json_pinned(url, deadline):
    """GETs `url`, following up to MAX_REDIRECTS https redirects, each
    resolved and connected by pinned IP. Every read is bounded both in size
    (MAX_RESPONSE_BYTES) and against `deadline`, an absolute wall-clock
    cutoff for the whole fetch (including all redirects), not just each
    individual socket operation — so a slow trickle can't hold it open."""
    context = ssl.create_default_context()
    for _ in range(MAX_REDIRECTS + 1):
        parsed = urlsplit(url)
        if parsed.scheme != "https" or not parsed.hostname:
            return None
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return None
        ip = _resolve_public_ip(parsed.hostname, remaining)
        if ip is None:
            return None
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return None
        port = parsed.port or 443
        path = parsed.path or "/"
        if parsed.query:
            path += "?" + parsed.query
        conn = _PinnedHTTPSConnection(parsed.hostname, ip, port, min(remaining, LOOKUP_TIMEOUT), context)
        try:
            conn.request("GET", path, headers={"Accept": "application/json"})
            resp = conn.getresponse()
            if resp.status in (301, 302, 303, 307, 308):
                location = resp.getheader("Location")
                resp.read(MAX_RESPONSE_BYTES)
                if not location:
                    return None
                url = urljoin(url, location)
                continue
            if resp.status != 200:
                return None
            body = b""
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return None
                try:
                    conn.sock.settimeout(remaining)
                except Exception:
                    pass
                chunk = resp.read(8192)
                if not chunk:
                    break
                body += chunk
                if len(body) > MAX_RESPONSE_BYTES:
                    return None
            return body
        except Exception:
            return None
        finally:
            conn.close()
    return None


def lookup_country(ip):
    try:
        deadline = time.monotonic() + LOOKUP_TIMEOUT
        body = _fetch_json_pinned("https://ipwho.is/%s" % ip, deadline)
        if body is None:
            return None
        data = json.loads(body.decode("utf-8", "replace"))
        if data.get("success") is False:
            return None
        code = _sanitize_country_code(data.get("country_code"))
        name = _sanitize_country_name(data.get("country"))
        if not code:
            return None
        return {"code": code, "name": name, "ts": time.time()}
    except Exception:
        return None


# --------------------------------------------------------- cache dir access

def _open_component(parent_fd, name, create_mode=None):
    """Open exactly one path component under an already-open, verified
    parent directory fd. Refuses to follow a symlink (O_NOFOLLOW on a
    single component, not a multi-segment path, so this can't be bypassed
    by an intermediate symlink), and refuses to reuse anything that isn't a
    directory owned by us/root with no group/other write bit."""
    if create_mode is not None:
        try:
            os.mkdir(name, create_mode, dir_fd=parent_fd)
        except FileExistsError:
            pass
    fd = os.open(name, os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_RDONLY, dir_fd=parent_fd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode):
            raise PermissionError("not a directory: %r" % name)
        if st.st_uid not in _TRUSTED_OWNERS:
            raise PermissionError("untrusted owner for %r" % name)
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise PermissionError("group/other-writable directory: %r" % name)
        if create_mode is not None:
            os.fchmod(fd, create_mode)
    except Exception:
        os.close(fd)
        raise
    return fd


def open_cache_dir():
    """Component-wise walk to $XDG_CACHE_HOME/omarchy/omanetmonitor (or
    ~/.cache/omarchy/omanetmonitor), verifying ownership/type/mode at every
    hop and refusing to follow a symlink anywhere in the chain. Returns an
    open fd to the final, verified, 0700 directory; raises on failure,
    which callers treat the same as any other cache-unavailable case."""
    xdg = os.environ.get("XDG_CACHE_HOME")
    base = xdg if xdg and os.path.isabs(xdg) else os.path.join(os.path.expanduser("~"), ".cache")

    fd = os.open(os.sep, os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for part in [p for p in base.split(os.sep) if p]:
            nxt = _open_component(fd, part)
            os.close(fd)
            fd = nxt
        for part, mode in (("omarchy", 0o755), ("omanetmonitor", 0o700)):
            nxt = _open_component(fd, part, create_mode=mode)
            os.close(fd)
            fd = nxt
        return fd
    except Exception:
        os.close(fd)
        raise


def load_cache_fd(dir_fd):
    fd = -1
    try:
        fd = os.open("geoip-cache.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dir_fd)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid not in _TRUSTED_OWNERS:
            return {}
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            return {}
        if st.st_size > MAX_CACHE_BYTES:
            return {}
        os.set_blocking(fd, True)
        with os.fdopen(fd, "rb") as f:
            fd = -1  # fdopen owns the fd now; don't close it again below
            raw = f.read(MAX_CACHE_BYTES + 1)
        if len(raw) > MAX_CACHE_BYTES:
            return {}
        data = json.loads(raw.decode("utf-8", "replace"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}
    finally:
        if fd >= 0:
            try:
                os.close(fd)
            except Exception:
                pass


def save_cache_fd(dir_fd, cache):
    if len(cache) > MAX_CACHE_ENTRIES:
        items = sorted(cache.items(), key=lambda kv: (kv[1].get("ts", 0) if isinstance(kv[1], dict) else 0))
        cache = dict(items[-MAX_CACHE_ENTRIES:])

    tmp_name = ".geoip-cache.%s.tmp" % secrets.token_hex(8)
    fd = -1
    try:
        # O_EXCL|O_NOFOLLOW on a randomly chosen name: nothing to race
        # against, since nothing else could have predicted this name.
        fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dir_fd)
        with os.fdopen(fd, "w") as f:
            fd = -1
            json.dump(cache, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_name, "geoip-cache.json", src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except Exception:
        if fd >= 0:
            try:
                os.close(fd)
            except Exception:
                pass
        try:
            os.unlink(tmp_name, dir_fd=dir_fd)
        except Exception:
            pass
    return cache


# ------------------------------------------------------------------- ss scan

def parse_peers():
    """Returns established-peer counts from `ss`, or raises ScanUnavailable
    for anything short of a fully drained, verified-zero-exit run — never a
    partial/empty result silently presented as "no connections"."""
    try:
        proc = subprocess.Popen(
            ["ss", "-Htn", "state", "established"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            start_new_session=True,  # own process group, so a timeout can kill it and any children cleanly
        )
    except Exception as exc:
        raise ScanUnavailable("failed to start ss") from exc

    deadline = time.monotonic() + SS_TIMEOUT
    chunks = []
    total = 0
    overflow = False
    timed_out = False
    stdout_fd = proc.stdout.fileno()
    os.set_blocking(stdout_fd, False)
    sel = selectors.DefaultSelector()
    sel.register(proc.stdout, selectors.EVENT_READ)
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                break
            for _key, _mask in sel.select(timeout=min(remaining, SS_POLL_INTERVAL)):
                try:
                    chunk = os.read(stdout_fd, 65536)
                except (BlockingIOError, OSError):
                    chunk = b""
                if not chunk:
                    continue
                total += len(chunk)
                if total > MAX_SS_OUTPUT_BYTES:
                    overflow = True
                    break
                chunks.append(chunk)
            if overflow:
                break
            if proc.poll() is not None:
                break
    finally:
        sel.close()
        if proc.poll() is None:
            try:
                os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        try:
            proc.wait(timeout=1)
        except Exception:
            pass
        try:
            proc.stdout.close()
        except Exception:
            pass

    if overflow:
        raise ScanUnavailable("ss output exceeded %d bytes" % MAX_SS_OUTPUT_BYTES)
    if timed_out:
        raise ScanUnavailable("ss did not complete within %.1fs" % SS_TIMEOUT)
    if proc.returncode != 0:
        raise ScanUnavailable("ss exited with code %r" % proc.returncode)

    out = b"".join(chunks).decode("utf-8", "replace")

    counts = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        peer = parts[-1]
        if peer.startswith("["):
            end = peer.find("]")
            if end == -1:
                continue
            ip = peer[1:end]
            rest = peer[end + 2:]
        else:
            idx = peer.rfind(":")
            if idx == -1:
                continue
            ip = peer[:idx]
            rest = peer[idx + 1:]
        ip = ip.split("%")[0]
        try:
            port = int(rest)
        except ValueError:
            continue
        try:
            addr = ipaddress.ip_address(ip)
        except ValueError:
            continue
        if not _is_public_address(addr):
            continue
        key = (ip, port)
        counts[key] = counts.get(key, 0) + 1
    return counts


def main():
    allowed_raw = sys.argv[1] if len(sys.argv) > 1 else "US"
    allowed = set()
    for c in allowed_raw.split(","):
        code = _sanitize_country_code(c)
        if code:
            allowed.add(code)
        if len(allowed) >= MAX_ALLOWED_CODES:
            break
    if not allowed:
        allowed = {"US"}

    try:
        counts = parse_peers()
    except ScanUnavailable as exc:
        sys.stderr.write("omanetmonitor-scan: %s\n" % exc)
        sys.exit(1)

    try:
        cache_dir_fd = open_cache_dir()
    except Exception:
        cache_dir_fd = None

    cache = load_cache_fd(cache_dir_fd) if cache_dir_fd is not None else {}
    cache = _sanitize_cache(cache)

    ips = sorted(set(ip for ip, _port in counts.keys()))

    now = time.time()
    stale = [ip for ip in ips if ip not in cache or (now - cache[ip].get("ts", 0)) > CACHE_TTL]
    stale = stale[:MAX_NEW_LOOKUPS]

    if stale:
        with ThreadPoolExecutor(max_workers=MAX_WORKERS) as ex:
            results = list(zip(stale, ex.map(lookup_country, stale)))
        changed = False
        for ip, res in results:
            if res:
                cache[ip] = res
                changed = True
        if changed and cache_dir_fd is not None:
            cache = save_cache_fd(cache_dir_fd, cache)

    if cache_dir_fd is not None:
        try:
            os.close(cache_dir_fd)
        except Exception:
            pass

    entries = []
    for (ip, port), count in counts.items():
        info = cache.get(ip)
        code = _sanitize_country_code(info.get("code")) if info else ""
        name = _sanitize_country_name(info.get("name")) if info else "Unknown"
        flagged = code not in allowed
        entries.append({
            "ip": ip,
            "port": port,
            "countryCode": code,
            "countryName": name,
            "count": count,
            "flagged": flagged,
        })

    flagged_entries = [e for e in entries if e["flagged"]]
    flagged_entries.sort(key=lambda e: (-e["count"], e["ip"]))
    flagged_entries = flagged_entries[:MAX_FLAGGED_ENTRIES]

    result = {
        "generatedAt": int(now),
        "totalConnections": sum(counts.values()),
        "totalUniquePeers": len(counts),
        "totalFlagged": len(flagged_entries),
        "flagged": flagged_entries,
    }

    result_json = json.dumps(result)
    while len(result_json) > MAX_RESULT_BYTES and result["flagged"]:
        result["flagged"].pop()
        result["totalFlagged"] = len(result["flagged"])
        result_json = json.dumps(result)

    print(result_json)


if __name__ == "__main__":
    main()
